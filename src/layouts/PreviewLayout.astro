---
import Icon from '../components/Icon.astro';
import '../styles/main.css';
import '../styles/combined-direction.css';
import '../styles/preview-pages.css';
const {title,description='David Bennett. Digital humans, creative technology and conversations about AI.'}=Astro.props;
const linkedin='https://www.linkedin.com/in/davidbennettmimic/';
const imdb='https://www.imdb.com/name/nm3186843/';
const email='mailto:dbennett@mimicproductions.com';
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><meta name="description" content={description}/><meta http-equiv="Content-Security-Policy" content="default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self' ws://127.0.0.1:4398; frame-src 'none'; worker-src 'none'; media-src 'self'; object-src 'none'; base-uri 'self'"/><title>{title} | David Bennett</title><link rel="icon" href="/favicon-live.webp"/><link rel="preload" href="/fonts/questrial.woff2" as="font" type="font/woff2" crossorigin/></head>
<body><a class="skip" href="#main">Skip to content</a><div class="site-frame">
<header class="masthead"><a class="identity" href="/combined-direction/" aria-label="David Bennett home"><span>DAVID BENNETT</span></a><button class="menu-toggle" aria-controls="navigation" aria-expanded="false">Menu <Icon name="plus" size={16}/></button><nav id="navigation" aria-label="Main navigation"><a href="/combined-direction/brands/">BRANDS</a><a href="/combined-direction/events/">EVENTS</a><a href="/combined-direction/blog/">BLOG</a></nav><a class="button small header-connect" href={linkedin} target="_blank" rel="noopener noreferrer">Let’s connect <Icon name="linkedin" size={17}/></a></header>
<main id="main" class="detail-page editorial-page"><slot/></main><footer class="footer dark"><div class="footer-top"><a class="identity" href="/combined-direction/"><span>DAVID BENNETT</span></a><nav aria-label="Social profiles"><a href={linkedin} target="_blank" rel="noopener noreferrer" aria-label="David on LinkedIn"><Icon name="linkedin" size={18}/></a><a href={imdb} target="_blank" rel="noopener noreferrer">IMDb</a><a href="https://www.instagram.com/davidaaronbennett/" target="_blank" rel="noopener noreferrer">Instagram</a><a href="/combined-direction/contact/" aria-label="Contact David"><Icon name="mail" size={18}/></a></nav><a href="/combined-direction/about/">About</a><a href="/combined-direction/contact/">Contact</a><a href="/combined-direction/" class="back-top">BACK TO TOP <Icon size={15}/></a></div><div class="footer-bottom"><span>© {new Date().getFullYear()} David Bennett</span><span>Mimic Productions <b>·</b> Mimic Minds</span><a href={email}>dbennett@mimicproductions.com</a></div></footer></div><script>const b=document.querySelector('.menu-toggle');const n=document.querySelector('#navigation');b?.addEventListener('click',()=>{const o=b.getAttribute('aria-expanded')!=='true';b.setAttribute('aria-expanded',String(o));n?.classList.toggle('open',o)});</script></body></html>