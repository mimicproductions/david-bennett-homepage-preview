---
import Icon from '../components/Icon.astro';
import '../styles/main.css';
import '../styles/combined-direction.css';
import events from '../data/events.json';
import brands from '../data/brands.json';
const linkedin='https://www.linkedin.com/in/davidbennettmimic/';
const imdb='https://www.imdb.com/name/nm3186843/';
const email='mailto:dbennett@mimicproductions.com';
const collaborators=["Cate Blanchett", "Keanu Reeves", "Beyonce", "Kanye West", "Lady Gaga", "Naomi Campbell", "Bjork", "Travis Scott", "Lil Nas X", "Jeff Koons", "Angelina Jolie", "Anthony Hopkins", "John Malkovich", "Sam Worthington", "Tom Hanks", "Zoe Saldana", "Sigourney Weaver", "Maggie Gyllenhaal", "Simon Pegg", "Robin Wright Penn", "Jon Heder", "Steve Buscemi", "The 1975", "Sophia Robot", "KDA", "Marina Abramovic", "Kendall Jenner", "Peaches", "Cristiano Ronaldo", "Roger Federer", "J. Balvin", "Jason Schwartzman", "Jonathan Banks", "Olafur Eliasson", "Noomi Rapace", "Kojey", "Griff", "Arca", "Ed Atkins", "Apache", "Robin Schulz", "Carrie Anne Moss", "Neymar", "Yahya Abdul-Mateen II", "Lana Wachowski", "Toni Garrn", "Tyson Fury", "Will Smith"];
const films=[["home-4", "Avatar", "2009"], ["home-3", "The Adventures of Tintin", "2011"], ["home-6", "Rise of the Planet of the Apes", "2011"], ["home-15", "The Polar Express", "2004"], ["home-16", "Beowulf", "2007"], ["home-2", "Captain America: Civil War", ""], ["home-5", "Borderlands 3", ""], ["home-7", "Batman: Arkham Knight", ""], ["home-8", "The Matrix Resurrections", ""], ["home-9", "1899", ""], ["home-10", "Spides", ""], ["home-11", "Euphoria", ""], ["home-12", "R’ha", ""], ["home-13", "Uncanny Me", ""], ["home-14", "The Last Voyage of the Demeter", ""]];
const studios=[['Mimic VFX','Film & visual effects','brands-1','https://www.mimicvfx.com/'],['Mimic Digital Fashion','Fashion & virtual expression','brands-8','https://www.mimicdigitalfashion.com/'],['Mimic Advertising','Characters for brands','brands-7','https://www.mimicadvertising.com/'],['Mimic Education','Learning & digital tutors','brands-25','https://www.mimiceducation.com/'],['Mimic Mobility','Connected experiences','brands-20','https://www.mimicmobility.com/'],['Mimic Immersive','Art & spatial storytelling','brands-22','https://www.mimicimmersive.com/']];
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><meta name="description" content="David Bennett, founder of Mimic Productions and Mimic Minds. Explore digital humans, film credits, speaking and the Mimic ecosystem."/><meta http-equiv="Content-Security-Policy" content="default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self' ws://127.0.0.1:4398; frame-src 'none'; worker-src 'none'; media-src 'self'; object-src 'none'; base-uri 'self'"/><title>David Bennett | Digital humans. Human possibilities.</title><link rel="icon" href="/favicon-live.webp"/><link rel="preload" href="/fonts/questrial.woff2" as="font" type="font/woff2" crossorigin/></head>
<body><a class="skip" href="#main">Skip to content</a><div class="site-frame">
<header class="masthead"><a class="identity" href="#home" aria-label="David Bennett home"><span>DAVID BENNETT</span></a><button class="menu-toggle" aria-controls="navigation" aria-expanded="false">Menu <Icon name="plus" size={16}/></button><nav id="navigation" aria-label="Main navigation"><a href="/combined-direction/brands/">BRANDS</a><a href="/combined-direction/events/">EVENTS</a><a href="/combined-direction/blog/">BLOG</a></nav><a class="button small header-connect" href={linkedin} target="_blank" rel="noopener noreferrer">Let’s connect <Icon name="linkedin" size={17}/></a></header>
<main id="main">
<section class="hero live-style-hero dark" id="home"><video class="live-hero-video" autoplay muted loop playsinline preload="metadata" poster="/images/home-0.webp" aria-label="David Bennett at the studio"><source src="/images/david-hero.mp4" type="video/mp4"/></video><div class="live-hero-shade"></div><h1 class="hero-quote">“In the realm of digital humans and AI, imagination knows no bounds, and the future is ours to craft.”</h1><nav class="hero-topics" aria-label="Explore David’s work"><a href="/combined-direction/about/">Futurism</a><a href="https://www.mimicproductions.com/">Digital Humans</a><a href="https://www.mimicminds.com/mimic-ai-studio">AI Avatars</a><a href="https://www.mimicrobotic.com/">Humanoid Robotics</a><a href="/combined-direction/about/#about">Transhumanism</a></nav></section>
<section class="client-brands" aria-label="Brands David has worked with"><div class="brand-marquee"><div class="brand-wordmarks"><img src="/images/client-adidas.webp" alt="Adidas" width="220" height="100" loading="lazy"/><img src="/images/client-cartier.webp" alt="Cartier" width="220" height="100" loading="lazy"/><img src="/images/client-coca.webp" alt="Coca-Cola" width="220" height="100" loading="lazy"/><img src="/images/client-netflix.webp" alt="Netflix" width="220" height="100" loading="lazy"/><img src="/images/client-swatch.webp" alt="Swatch" width="220" height="100" loading="lazy"/><img src="/images/client-google.webp" alt="Google" width="220" height="100" loading="lazy"/><div class="brand-repeat" aria-hidden="true"><img src="/images/client-adidas.webp" alt="Adidas" width="220" height="100" loading="lazy"/><img src="/images/client-cartier.webp" alt="Cartier" width="220" height="100" loading="lazy"/><img src="/images/client-coca.webp" alt="Coca-Cola" width="220" height="100" loading="lazy"/><img src="/images/client-netflix.webp" alt="Netflix" width="220" height="100" loading="lazy"/><img src="/images/client-swatch.webp" alt="Swatch" width="220" height="100" loading="lazy"/><img src="/images/client-google.webp" alt="Google" width="220" height="100" loading="lazy"/></div></div></div></section>
<section class="credits dark section" id="credits"><div class="section-heading"><div><span class="eyebrow">SELECTED CAREER CREDITS</span><h2>Selected credits.</h2></div><div class="imdb-intro"><span class="imdb-mark">IMDb</span><a class="text-button" href={imdb} target="_blank" rel="noopener noreferrer">View David’s IMDb profile <Icon size={17}/></a></div></div><div class="credit-controls"><button data-credits-prev aria-label="Previous credits" aria-controls="credit-track"><Icon name="chevron" size={18}/></button><button data-credits-next aria-label="Next credits" aria-controls="credit-track"><Icon name="chevron" size={18}/></button></div><div class="film-grid" id="credit-track">{films.map(([image,title,year])=><a class="film-card" href={imdb} target="_blank" rel="noopener noreferrer"><img src={'/images/'+image+'.webp'} alt={title+' film artwork'} width="400" height="580" loading="lazy"/><div><h3>{title}</h3>{year&&<span>{year}</span>}</div></a>)}</div></section>
<section class="about light section" id="about"><div class="about-photo"><img src="/images/events-13.webp" alt="David Bennett at the Montreal International Game Summit" width="1280" height="1600" loading="lazy"/></div><div class="about-copy"><span class="eyebrow">DAVID BENNETT</span><h2>The Futurist</h2><p>David Bennett is a futurist and technologist with over 30 years of experience in visual effects, motion capture, XR, AI, and digital doubles. A pioneer in facial animation, he has worked on films like <i>Avatar</i>, <i>Tintin</i>, and <i>Rise of the Planet of the Apes</i>, and collaborated with artists such as Lady Gaga, Beyoncé, and Kanye West, as well as brands like Warner Brothers, Nike, and Adidas. David has 2 provisional patents, one in AI and one in robotics.</p><p>Currently, he is focused on developing realtime conversational AI avatars with applications across various industries, including education, training, medical care and well-being. </p><p>David actively contributes to the global AI dialogue, speaking at events like the AI for Developing Countries Forum at the UN, SXSW, AWE and EU AI policy roundtables.</p><a class="text-button" href="/combined-direction/about/">More about David <Icon size={16}/></a></div></section>
<section class="original-content light section collaborations" id="collaborations"><div><h2>50+ celebrity<br/>collaborations.</h2><p>{collaborators.slice(0,12).join(', ')}.</p><details class="plain-details"><summary>See the full collaborator list <Icon name="plus" size={16}/></summary><p>{collaborators.slice(12).join(', ')}.</p></details></div><figure><video controls playsinline preload="none" poster="/images/home-17.webp" aria-label="Mimic Productions digital human work"><source src="/images/digital-humans-reel.mp4" type="video/mp4"/></video><figcaption>Digital human work from Mimic Productions.</figcaption></figure></section>
<section class="personal-note light section"><h2>My work.</h2><div><p>I began in facial animation and performance capture. Today, my work also includes digital characters that can hold a conversation and respond in real time.</p><p>At Mimic, I bring those two areas together: character production and conversational AI.</p></div></section>
<section class="mimicverse-edit dark section" id="mimicverse"><div class="plain-section-heading"><h2>Mimicverse.</h2><a class="text-button" href="/combined-direction/brands/">All brands <Icon size={16}/></a></div><p class="mimicverse-context">Mimic’s specialist brands connect 3D character production, immersive experiences and AI across different industries.</p><div class="parent-brands"><article class="parent-brand primary-brand"><a class="parent-image" href="https://www.mimicproductions.com/"><img src="/images/studio-location.webp" alt="The Mimic Productions studio in Berlin" width="1400" height="933" loading="lazy"/></a><div class="parent-brand-copy"><img class="parent-logo productions-logo" src="/images/mimic-productions-logo.png" alt="Mimic Productions" width="300" height="100" loading="lazy"/><p>Based in Berlin, Mimic Productions creates digital humans, facial animation, performance capture and XR for film, games, fashion, healthcare and mobility.</p><a class="text-button" href="https://www.mimicproductions.com/">Visit Mimic Productions <Icon size={16}/></a></div></article><article class="parent-brand"><div class="parent-image parent-video"><video controls playsinline preload="none" poster="/images/home-29.webp" aria-label="Mimic Minds conversational AI video"><source src="/images/mimic-minds-reel.mp4" type="video/mp4"/></video></div><div class="parent-brand-copy"><img class="parent-logo minds-logo" src="/images/mimic-minds-logo.png" alt="Mimic Minds" width="300" height="100" loading="lazy"/><p>Smart conversational AI avatars for real-time interaction in entertainment, education, training, customer service and healthcare.</p><a class="text-button" href="https://www.mimicminds.com/">Visit Mimic Minds <Icon size={16}/></a></div></article></div><div class="brand-slider"><div class="brand-slider-controls"><button data-brands-prev aria-label="Previous brands" aria-controls="brand-track"><Icon name="chevron" size={18}/></button><button data-brands-next aria-label="Next brands" aria-controls="brand-track"><Icon name="chevron" size={18}/></button></div><div class="compact-studios brand-track" id="brand-track" aria-label="All 20 Mimic brands">{brands.map(brand=><a href={brand.href}><img src={brand.image} alt={brand.name} width="600" height="400" loading="lazy"/><h3>{brand.name}</h3></a>)}</div></div></section>
<section class="events light section" id="events"><div class="section-heading"><div><h2>Events & talks.</h2><p class="speaking-context">David speaks about digital humans, AI, XR and digital transformation. His appearances include the United Nations, SXSW, AWE, SIGGRAPH, SIGGRAPH Asia, GITEX and EU AI policy roundtables.</p></div><div class="events-actions"><div class="slider-controls"><button data-events-prev aria-label="Previous events" aria-controls="event-track"><Icon name="chevron"/></button><button data-events-pause aria-label="Pause automatic event slides" aria-pressed="false"><Icon name="pause" size={17}/><span>Pause</span></button><button data-events-next aria-label="Next events" aria-controls="event-track"><Icon name="chevron"/></button></div></div></div><div class="event-track" id="event-track" aria-label="David’s selected speaking appearances">{events.map(e=><article class="event-card"><a href={e.href} target="_blank" rel="noopener noreferrer"><div class="event-photo"><img src={e.image} alt={'David Bennett at '+e.title} width="900" height="560" loading="lazy"/></div><div class="event-copy"><span class="eyebrow">{e.place}</span><h3>{e.title}</h3><p>{e.description}</p><span class="event-link">View appearance <Icon size={16}/></span></div></a></article>)}</div><div class="event-footer"><span data-events-position>01 / 04</span><span class="slider-rule"></span><a href="/combined-direction/events/">All appearances <Icon size={16}/></a></div></section>
<section class="original-content light section" id="pope-un"><figure><img src="/images/home-18.webp" alt="David Bennett meeting Pope Francis in Rome in 2024" width="1600" height="1067" loading="lazy"/><figcaption>David with Pope Francis at the Human Economic Forum, Rome, 2024.</figcaption></figure><div><h2>Pope Francis &<br/>the United Nations.</h2><p>In 2024, David met Pope Francis at the Human Economic Forum in Rome, joining policymakers and experts in discussions about AI.</p><p>He also spoke at the United Nations in Vienna, advocating for inclusive and sustainable AI solutions for developing countries.</p><a class="text-button" href="/combined-direction/events/">Explore David’s appearances <Icon size={16}/></a></div></section>
<section class="original-content light section robotics-story" id="robotics"><div><h2>Humanoid robotics<br/>& transhumanism.</h2><p>David’s interest in robotics grew while working on <i>Beowulf</i>, where he oversaw motion capture for Anthony Hopkins’ character. Studying Hopkins’ face led him to imagine recreating human expression through animatronics and to file a provisional patent application for robotic skin.</p><p>Mimic Productions was initially envisioned as a robotics company. Its work expanded into digital humans, performance capture and AI-driven interactive characters, while David continued exploring synthetic human likeness.</p><a class="text-button" href="https://www.mimicrobotic.com/">Visit Mimic Robotic <Icon size={16}/></a></div><figure><img src="/images/home-30.webp" alt="Humanoid robotics illustration from David Bennett’s original website" width="1312" height="896" loading="lazy"/></figure></section>
<section class="personal-note light section arts-note" id="arts"><h2>Philanthropy<br/>for the arts.</h2><div><p>David supports the arts and emerging artists, helping bring artistic projects to life and encouraging creative expression and collaboration.</p></div></section>
<section class="keep-in-touch light section" id="contact"><div class="keep-photo"><img src="/images/events-0.webp" alt="David Bennett at the Euphoria screening at Kino International" width="1000" height="800" loading="lazy"/></div><div class="keep-copy"><h2>Keep in touch.</h2><p>I share updates from the studio and events on LinkedIn.</p><span class="linkedin-followers"><Icon name="linkedin" size={18}/> 20K+ followers</span><div class="button-row"><a class="button" href={linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <Icon name="linkedin" size={17}/></a><a class="button outline" href="/combined-direction/contact/">Invite me to speak <Icon name="mic" size={17}/></a></div></div></section>
</main><footer class="footer dark"><div class="footer-top"><a class="identity" href="#home"><span>DAVID BENNETT</span></a><nav aria-label="Social profiles"><a href={linkedin} target="_blank" rel="noopener noreferrer" aria-label="David on LinkedIn"><Icon name="linkedin" size={18}/></a><a href={imdb} target="_blank" rel="noopener noreferrer">IMDb</a><a href="https://www.instagram.com/davidaaronbennett/" target="_blank" rel="noopener noreferrer">Instagram</a><a href="https://www.facebook.com/dbanimation/" target="_blank" rel="noopener noreferrer">Facebook</a><a href="https://www.twitter.com/davidbennett_x" target="_blank" rel="noopener noreferrer">X</a><a href="/combined-direction/contact/" aria-label="Contact David"><Icon name="mail" size={18}/></a></nav><a href="/combined-direction/about/">About</a><a href="/combined-direction/contact/">Contact</a><a href="#home" class="back-top">BACK TO TOP <Icon size={15}/></a></div><div class="footer-bottom"><span>© {new Date().getFullYear()} David Bennett</span><span>Mimic Productions <b>·</b> Mimic Minds</span><a href={email}>dbennett@mimicproductions.com</a></div></footer>
</div>
<script>
const inlineVideos=document.querySelectorAll<HTMLVideoElement>('main video[controls]');const inlineObserver=new IntersectionObserver(entries=>entries.forEach(entry=>{if(!entry.isIntersecting)(entry.target as HTMLVideoElement).pause();}),{threshold:.05});inlineVideos.forEach(video=>inlineObserver.observe(video));
const heroVideo=document.querySelector<HTMLVideoElement>('.live-hero-video');if(matchMedia('(prefers-reduced-motion: reduce)').matches)heroVideo?.pause();
const menu=document.querySelector<HTMLButtonElement>('.menu-toggle');const nav=document.querySelector<HTMLElement>('#navigation');
menu?.addEventListener('click',()=>{const open=menu.getAttribute('aria-expanded')!=='true';menu.setAttribute('aria-expanded',String(open));nav?.classList.toggle('open',open)});
nav?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{nav.classList.remove('open');menu?.setAttribute('aria-expanded','false')}));
document.addEventListener('keydown',e=>{if(e.key==='Escape'){nav?.classList.remove('open');menu?.setAttribute('aria-expanded','false')}});
const bindRail=(id:string,previous:string,next:string)=>{const rail=document.querySelector<HTMLElement>(id)!;const prev=document.querySelector<HTMLButtonElement>(previous)!;const forward=document.querySelector<HTMLButtonElement>(next)!;const state=()=>{prev.disabled=rail.scrollLeft<2;forward.disabled=rail.scrollLeft+rail.clientWidth>=rail.scrollWidth-2;};const move=(direction:number)=>{const amount=rail.querySelector('a')!.getBoundingClientRect().width+parseFloat(getComputedStyle(rail).columnGap||'20');rail.scrollBy({left:direction*amount,behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'});};prev.addEventListener('click',()=>move(-1));forward.addEventListener('click',()=>move(1));rail.addEventListener('scroll',state,{passive:true});addEventListener('resize',state);state();};
bindRail('#brand-track','[data-brands-prev]','[data-brands-next]');bindRail('#credit-track','[data-credits-prev]','[data-credits-next]');
const track=document.querySelector<HTMLElement>('#event-track')!;const pause=document.querySelector<HTMLButtonElement>('[data-events-pause]')!;const reduced=matchMedia('(prefers-reduced-motion: reduce)');let paused=reduced.matches,hovered=false,focused=false,visible=false,timer:ReturnType<typeof setInterval>|undefined;
const step=()=>track.querySelector('article')!.getBoundingClientRect().width+24;
const positions=()=>Math.max(1,Math.round((track.scrollWidth-track.clientWidth)/step())+1);
const update=()=>{document.querySelector('[data-events-position]')!.textContent=String(Math.round(track.scrollLeft/step())+1).padStart(2,'0')+' / '+String(positions()).padStart(2,'0');};
const move=(direction:number)=>{const count=positions();const index=(Math.round(track.scrollLeft/step())+direction+count)%count;track.scrollTo({left:index*step(),behavior:reduced.matches?'instant':'smooth'})};
const sync=()=>{if(timer)clearInterval(timer);if(!paused&&!hovered&&!focused&&visible&&!document.hidden&&!reduced.matches)timer=setInterval(()=>move(1),5200);pause.setAttribute('aria-pressed',String(paused));pause.setAttribute('aria-label',paused?'Start automatic event slides':'Pause automatic event slides');pause.querySelector('span')!.textContent=paused?'Play':'Pause';};
pause.addEventListener('click',()=>{paused=!paused;sync()});
document.querySelector('[data-events-next]')?.addEventListener('click',()=>{paused=true;move(1);sync()});document.querySelector('[data-events-prev]')?.addEventListener('click',()=>{paused=true;move(-1);sync()});
track.addEventListener('mouseenter',()=>{hovered=true;sync()});track.addEventListener('mouseleave',()=>{hovered=false;sync()});track.addEventListener('focusin',()=>{focused=true;sync()});track.addEventListener('focusout',()=>{focused=false;sync()});track.addEventListener('pointerdown',()=>{paused=true;sync()});track.addEventListener('scroll',update,{passive:true});
new IntersectionObserver(e=>{visible=e[0].isIntersecting;sync()},{threshold:.2}).observe(track);document.addEventListener('visibilitychange',sync);reduced.addEventListener('change',()=>{if(reduced.matches)paused=true;sync()});addEventListener('resize',update);update();sync();
</script>
</body></html>
