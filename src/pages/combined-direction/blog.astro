---
import PreviewLayout from '../../layouts/PreviewLayout.astro';
import Icon from '../../components/Icon.astro';
import posts from '../../data/posts.json';
const [latest,...stories]=posts;
---
<PreviewLayout title="Blog"><section class="section light editorial-intro"><div><span class="eyebrow">THE BLOG / DAVID BENNETT</span><h1>Ideas, in<br/><em>progress.</em></h1></div><p>From the studio to the stage. Stories about digital humans, creative work and the human side of AI.</p></section><section class="section light latest-section"><a class="latest-story" href={latest.href}><div class="latest-image"><img src={latest.image} alt={latest.title} width="1400" height="900" fetchpriority="high"/><span class="image-index">01 / LATEST ARTICLE</span></div><div class="latest-copy"><span class="eyebrow">{latest.dateLabel} · {latest.readMinutes} MIN READ</span><h2>{latest.title}</h2><p>{latest.description}</p><span class="button">Read the story <Icon/></span></div></a></section><section class="section light story-list"><div class="archive-heading"><h2>More from David.</h2><span class="eyebrow">ARTICLES / LATEST FIRST</span></div><div class="editorial-grid">{stories.map(post=><article class="story-card"><a class="story-image" href={post.href}><img src={post.image} alt={post.title} width="900" height="650" loading="lazy"/><span class="card-arrow"><Icon/></span></a><div class="story-meta">{post.dateLabel} · {post.readMinutes} MIN READ</div><h3><a href={post.href}>{post.title}</a></h3><p>{post.description}</p><a class="text-button" href={post.href}>Read article <Icon size={16}/></a></article>)}</div></section><section class="section dark editorial-cta"><span class="eyebrow">KEEP THE CONVERSATION GOING</span><h2>A question.<br/>An idea. A conversation.</h2><a class="button" href="/combined-direction/contact/">Contact David <Icon/></a></section></PreviewLayout>
