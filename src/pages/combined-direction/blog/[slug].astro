---
import PreviewLayout from '../../../layouts/PreviewLayout.astro';
import Icon from '../../../components/Icon.astro';
import posts from '../../../data/posts.json';
export function getStaticPaths(){return posts.map(post=>({params:{slug:post.slug},props:{post}}));}
const {post}=Astro.props;
const related=posts.filter(p=>p.slug!==post.slug).slice(0,3);
---
<PreviewLayout title={post.title} description={post.description}><article><header class="section light article-heading"><a class="article-back" href="/combined-direction/blog/">← BACK TO THE BLOG</a><h1>{post.title}</h1><p>{post.description}</p><div class="article-meta"><span>By David Bennett</span><time datetime={post.date}>{post.dateLabel}</time><span>{post.readMinutes} MIN READ</span></div></header><figure class="section light article-cover"><img src={post.image} alt={post.title} width="1400" height="850" fetchpriority="high"/></figure><div class="section light article-body-layout"><div class="article-content"><Fragment set:html={post.body}/><div class="article-source">Originally published on <a href={post.original}>davidaaronbennett.com</a>.</div></div><aside class="article-aside"><span class="eyebrow">IN THIS ARTICLE</span><nav aria-label="Article contents">{post.headings.map(heading=><a href={'#'+heading.id}>{heading.title}</a>)}</nav><p>Have a question or an idea to discuss?</p><a class="button" href="/combined-direction/contact/">Contact David <Icon size={16}/></a></aside></div></article><section class="section light story-list"><div class="archive-heading"><h2>Keep exploring.</h2><a class="text-button" href="/combined-direction/blog/">All articles <Icon size={16}/></a></div><div class="editorial-grid">{posts.filter(item=>item.slug!==post.slug).slice(0,3).map(item=><article class="story-card"><a class="story-image" href={item.href}><img src={item.image} alt={item.title} width="900" height="650" loading="lazy"/></a><div class="story-meta">{item.dateLabel}</div><h3><a href={item.href}>{item.title}</a></h3><a class="text-button" href={item.href}>Read article <Icon size={16}/></a></article>)}</div></section></PreviewLayout>