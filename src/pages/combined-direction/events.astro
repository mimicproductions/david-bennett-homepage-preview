const entries=[{"title": "Human-Like Technology | Austrian Strategic Business Summit, Tokyo", "description": "October 2025 | Panel Presentation David Bennett joined the Austrian Strategic Business Summit in Tokyo, sharing insights on human-like interaction with technology. He introduced Mimic Minds, showcasing how conversational AI avatars are shaping the future of digital communication and innovation.", "href": "https://www.linkedin.com/posts/davidbennettmimic_ai-conversationalai-avatars-activity-7381325468010188801-YP3A", "image": "/images/events-1.webp"}, {"title": "Showing Mimic AI studio | S-Tron China", "description": "October 2025 | Keynote Presentation David Bennett presented at S-Tron China (S\u521b\u4e2d\u56fd), sharing insights on digital humans and next-generation interaction. His talk explored how embodied AI connects with people through avatars and interfaces, highlighting Mimic Minds\u2019 innovations and the ethical evolution of AI communication shaping digital transformation.", "href": "https://www.linkedin.com/posts/davidbennettmimic_mimicproductions-mimicminds-mimicstudio-activity-7376965384983179264-hhVD", "image": "/images/events-2.webp"}, {"title": "Visiting NVIDIA Incubation Centre & Suzhou Technology Summit", "description": "September 2025 | Industry Collaboration David Bennett discussed how AI-driven 3D scanning and digital humans are transforming industries, showcasing innovations in spatial reality, avatar intelligence, and cross-border collaboration between Europe and China to advance the next generation of immersive technology.", "href": "https://www.linkedin.com/posts/davidbennettmimic_spatialreality-ai-innovation-activity-7371520196471316480-dH2h", "image": "/images/events-3.webp"}, {"title": "Scaling and Innovation in Conversational Al Avatars | CEVF", "description": "June 2025 | Keynote Presentation David Bennett explores how photorealistic conversational AI avatars are being scaled across sectors such as mobility and customer service. His session highlights breakthroughs in emotional intelligence, real-time dialogue, and venture capital trends shaping the digital human landscape.", "href": "https://www.youtube.com/watch?v=P1s89Y_La2c", "image": "/images/events-4.webp"}, {"title": "Can AI Avatars Really Understand Human Emotions?", "description": "May 2025 | Podcast Interview David Bennett probes whether AI avatars can comprehend and replicate human emotion\u2014exploring breakthroughs in emotional intelligence, practical uses in learning and creative collaboration, and challenges around credibility and empathy in AI models.", "href": "https://www.youtube.com/watch?v=HuU9SiSuC1Q", "image": "/images/events-5.webp"}, {"title": "Ethics and Ownership in the Age of Conversational AI Avatars", "description": "May 2025 | Keynote Presentation Presented at 42 Berlin in May 2025, David Bennett examines ethical concerns and ownership rights surrounding AI avatars. The session unpacks legal frameworks, moral responsibilities, data control, and creative authorship in conversational AI, offering essential insights for creators, educators, and tech innovators.", "href": "https://www.youtube.com/watch?v=sI3uvxd1RUk", "image": "/images/events-6.webp"}, {"title": "Future Narratives \u00d7 Health Care", "description": "March 2025 | Product Expo & Networking Unveiled Mimic Productions\u2019 Medical Conversational Avatar at Future Narratives \u00d7 Health Care in Berlin. Explored how XR transforms healthcare, with vibrant discussions, networking, and groundbreaking ideas from industry leaders and innovators.", "href": "https://www.linkedin.com/posts/david-bennett-ba30482_futurenarratives-healthcarexr-innovation-activity-7310213735590088704-erno", "image": "/images/events-7.webp"}, {"title": "Talking about AI with the Pope", "description": "February 2025 | Podcast David Bennett and Violeta Vasileva discuss AI technologies in dialogue with the Pope. Topics include the intersection of faith and AI, moral implications of digital humans, and the role of technology leaders in guiding ethical AI adoption.", "href": "https://www.youtube.com/watch?v=5jTbq25BTXU", "image": "/images/events-8.webp"}, {"title": "Digital Humans and Generative AI", "description": "November 2024 | Keynote Presentation At IndiaJoy 2024 in Hyderabad, a keynote on digital humans and generative AI explored future entertainment trends, sharing insights with VFX and games professionals.", "href": "https://www.instagram.com/vfxsummit_official/p/DCRILz5SVDY/?api=%E5%8F%B0%E5%8D%97%E6%89%BE%E5%B0%8F%E5%A7%90%E4%B8%8A%E9%97%A8%E6%9C%8D%E5%8A%A1%E9%A2%84%E7%BA%A6v%E4%BF%A18764603%E2%96%B7%E5%8F%B0%E5%8D%97%E6%89%BE%E5%B0%8F%E5%A7%90%E5%85%A8%E5%A5%97%E4%B8%8A%E9%97%A8%E6%9C%8D%E5%8A%A1%E2%96%B7%E5%8F%B0%E5%8D%97%E6%89%BE%E5%B0%8F%E5%A7%90%E7%BA%A6%E5%B0%8F%E5%A6%B9%E4%B8%8A%E9%97%A8%E6%9C%8D%E5%8A%A1%E2%96%B7%E5%8F%B0%E5%8D%97%E6%89%BE%E5%B0%8F%E5%A7%90%E6%9C%8D%E5%8A%A1%E8%81%94%E7%B3%BB%E6%96%B9%E5%BC%8F%E2%96%B7%E5%8F%B0%E5%8D%97%E6%89%BE%E5%B0%8F%E5%A7%90%E4%B8%8A%E8%AF%BE%E7%BA%A6%E5%B0%8F%E5%A6%B9%E7%89%B9%E6%AE%8A%E4%B8%8A%E9%97%A8%E6%9C%8D%E5%8A%A1.ynej&hl=zh-cn", "image": "/images/events-9.webp"}, {"title": "Digital Humans and generative Al: Exploring the future of interactive entertainment", "description": "November 2024 | Keynote Presentation David Bennett\u2019s session at IndiaJoy in Hyderabad explores how generative AI and digital humans are redefining interactive entertainment. The talk spans cinema, gaming, and creative storytelling, showcasing the convergence of AI, VFX, and immersive engagement.", "href": "https://www.youtube.com/watch?v=AsF8ypavoRM", "image": "/images/events-10.webp"}, {"title": "Digital Enterprise Strategy Meet | Maruti Suzuki", "description": "November 2024 | Corporate Innovation Presentation Presented the latest advancements in smart avatars at Maruti Suzuki India Digital Enterprise Strategy Meet in New Delhi showcasing AI-driven solutions for digital transformation and immersive technology in the mobility sector.", "href": "https://www.linkedin.com/feed/update/urn:li:activity:7262331279151431680/?actorCompanyId=2962658", "image": "/images/events-11.webp"}, {"title": "Interview with David Bennett CEO of Mimic Productions and Mimic Minds | AI Berlin", "description": "November 2024 | Expert Interview Article AI Berlin published an expert interview with David Bennett discussing Berlin\u2019s dynamic AI ecosystem, the future of digital humans, and how Mimic Productions is advancing conversational avatars and smart character technology.", "href": "https://ai-berlin.com/blog/article/david-bennett-ceo-von-mimic-productions-mimic-minds", "image": "/images/events-12.webp"}, {"title": "Montr\u00e9al International Games Summit", "description": "October 2024 | Conference Delegate Attended Montreal Games Summit 2024 as part of the XR & Games Berlin-Brandenburg delegation. Explored trends like AI storytelling, cross-platform innovation, and hyper-realistic graphics shaping the future of interactive entertainment.", "href": "https://www.linkedin.com/posts/david-bennett-ba30482_games-vfx-gameconference-activity-7258387294259134464-Kpvv", "image": "/images/events-13.webp"}, {"title": "GITEX Global and Expand North Star Dubai", "description": "October 2024 | Presentation Mimic Productions participated in GITEX Global and Expand North Star in Dubai, showcasing digital humans and smart avatars at the world\u2019s largest tech and startup show, engaging with global technology leaders and innovators.", "href": "https://www.linkedin.com/posts/david-bennett-ba30482_expandnorthstar2024-northstar-startupevent-activity-7251212386349514753-px0X/", "image": "/images/events-14.webp"}, {"title": "Chief AI Officer Summit", "description": "October 2024 | Summit Presentation David Bennett presented at the Chief AI Officer Summit in Berlin sharing insights on the transformative impact of AI-driven avatars exploring how artificial intelligence is redefining industries and unlocking human potential.", "href": "https://www.linkedin.com/posts/violeta-vasileva20_avatars-ai-technology-activity-7239958338585653248-qKKR/", "image": "/images/events-15.webp"}, {"title": "Vegasfest 2024 Chennai VFX Animation and Gaming Society", "description": "September 2024 | Conference Presentation David Bennett CEO of Mimic Productions presented at Vegasfest 2024 in Chennai showcasing VFX and digital human innovations to over 6600 attendees from the animation gaming and visual effects industries.", "href": "https://www.linkedin.com/posts/david-bennett-ba30482_vegasfeast-vfx-3d-activity-7249752341543813121-CyAC", "image": "/images/events-16.webp"}, {"title": "AI for Developing Countries Forum", "description": "August 2024 | Conference Speaker Honored to have spoken at the AI for Developing Countries forum: Fair AI for a Fair World at the United Nations in Vienna.", "href": "https://www.linkedin.com/feed/update/urn:li:activity:7219689771659399169/", "image": "/images/events-17.webp"}, {"title": "Innovating for Impact United Nations Development Programme Berlin", "description": "July 2024 | Technology Workshop Presentation David Bennett presented at Innovating for Impact Berlin 2024 with the UNDP Accelerator Labs exploring how digital humans and AI avatars can drive sustainable inclusive change and transform diverse sectors for social good.", "href": "https://www.linkedin.com/posts/david-bennett-ba30482_digitalhumans-ai-avatars-activity-7209865904623390720-fBg3/", "image": "/images/events-18.webp"}, {"title": "Maruti Suzuki Accelerator", "description": "July 2024 | Industry Delegation A flagship program of Maruti Suzuki Innovation, provides an opportunity to grow with Maruti Suzuki, sharing expertise, fostering collaboration with leading organizations, and exploring innovation in mobility, customer experience, and technology sectors.", "href": "https://www.linkedin.com/posts/david-bennett-ba30482_we-recently-hosted-german-startups-from-the-activity-7268645984807616512-mlfo", "image": "/images/events-19.webp"}, {"title": "David Bennett on Innovation and Industry Disruption at TOA 2024", "description": "June 2024 | Open Mic Interview Speaking at Tech Open Air Berlin, Bennett explored how digital humans and generative AI are revolutionizing creative industries\u2014from immersive storytelling in film to dynamic brand experiences. He demonstrated how AI-driven characters are reshaping media and entertainment landscapes.", "href": "https://www.youtube.com/watch?v=YP5wZRyDdCc", "image": "/images/events-20.webp"}, {"title": "Smart Avatars and Digital Humans at Tech Open Air Berlin", "description": "June 2024 | Conference Presentation David Bennett presented at Tech Open Air Berlin 2024 sharing insights on the future of digital humans and conversational avatars and discussing Mimic Productions\u2019 pioneering work in AI-driven character technology.", "href": "https://www.linkedin.com/posts/david-bennett-ba30482_in-the-realm-of-digital-humans-and-ai-imagination-activity-7206625694817095680-E2Ua", "image": "/images/events-21.webp"}, {"title": "Harnessing AI for Good: David Bennett's Vision for Developing Nations AIFOD", "description": "June 2024 | Thought Leadership Article AIFOD published an in-depth thought leadership piece featuring David Bennett\u2019s vision for harnessing AI avatars to drive social impact and inclusive development, with a focus on opportunities for developing nations.", "href": "https://aifod.org/harnessing-ai-for-good-david-bennetts-vision-for-developing-nations/", "image": "/images/events-22.webp"}, {"title": "Digital Humans and AI Week at re:publicca", "description": "May 2024 | Speaker Industry leaders explored the future of digital humans, motion capture, and XR storytelling at republica Berlin 2024, with Mimic Productions sharing expertise, showcasing capabilities, and hosting networking events at XR PORT BERLIN.", "href": "https://www.linkedin.com/feed/update/urn:li:activity:7203702569284550657/", "image": "/images/events-23.webp"}, {"title": "Creative Summer Bash", "description": "May 2024 | Panelist and Technology Exhibitor The Creative Summer Bash in Berlin brought together the digital and media industry for panels, interactive tech demos, and networking, highlighting new advancements in motion capture and AI-driven XR storytelling for creative professionals.", "href": "https://www.linkedin.com/feed/update/urn:li:activity:7201142441180033024/", "image": "/images/events-24.webp"}];
