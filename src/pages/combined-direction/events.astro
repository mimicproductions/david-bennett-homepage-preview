---
import PreviewLayout from '../../layouts/PreviewLayout.astro';
import Icon from '../../components/Icon.astro';
import events from '../../data/event-archive.json';
const [latest,...archive]=events;
---
<PreviewLayout title="Events"><section class="section light editorial-intro"><div><span class="eyebrow">ON STAGE / IN CONVERSATION</span><h1>Beyond<br/><em>the studio.</em></h1></div><p>Keynotes, panels and conversations about digital humans and AI. Explore David’s appearances, starting with the most recent.</p></section><section class="section light latest-section"><a class="latest-story" href={latest.href}><div class="latest-image"><img src={latest.image} alt={latest.title} width="1400" height="900" fetchpriority="high"/><span class="image-index">01 / MOST RECENT</span></div><div class="latest-copy"><span class="eyebrow">{latest.dateLabel}</span><h2>{latest.title}</h2><p>{latest.description}</p><span class="button">Explore the appearance <Icon/></span></div></a></section><section class="section light story-list"><div class="archive-heading"><h2>The event archive.</h2><span class="eyebrow">APPEARANCES / LATEST FIRST</span></div><div class="editorial-grid">{archive.map(event=><article class="story-card"><a class="story-image" href={event.href}><img src={event.image} alt={event.title} width="900" height="650" loading="lazy"/><span class="card-arrow"><Icon/></span></a><div class="story-meta">{event.dateLabel}</div><h3><a href={event.href}>{event.title}</a></h3><p>{event.description}</p><a class="text-button" href={event.href}>View appearance <Icon size={16}/></a></article>)}</div></section><section class="section dark editorial-cta"><span class="eyebrow">INVITE DAVID</span><h2>Bring the conversation<br/>to your audience.</h2><a class="button" href="/combined-direction/contact/">Discuss an event <Icon/></a></section></PreviewLayout>
