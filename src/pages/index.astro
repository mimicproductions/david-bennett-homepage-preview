---
import Icon from '../components/Icon.astro';
import '../styles/main.css';
import events from '../data/events.json';
const linkedin='https://www.linkedin.com/in/davidbennettmimic/';
const imdb='https://www.imdb.com/name/nm3186843/';
const email='mailto:dbennett@mimicproductions.com';
const topics=[['cube','Digital humans','From an actor’s performance to a character that feels alive.'],['spark','Conversational AI','Giving digital characters a voice, a personality and a way to connect.'],['mic','Ideas on stage','Digital identity, creative technology and the questions AI raises.'],['people','Human connection','Keeping expression and imagination at the centre of technology.']];
const films=[['home-4','Avatar','2009'],['home-3','The Adventures of Tintin','2011'],['home-6','Rise of the Planet of the Apes','2011'],['home-15','The Polar Express','2004'],['home-16','Beowulf','2007']];
const studios=[['Mimic VFX','Film & visual effects','brands-1','https://www.mimicvfx.com/'],['Mimic Digital Fashion','Fashion & virtual expression','brands-8','https://www.mimicdigitalfashion.com/'],['Mimic Advertising','Characters for brands','brands-7','https://www.mimicadvertising.com/'],['Mimic Education','Learning & digital tutors','brands-25','https://www.mimiceducation.com/'],['Mimic Mobility','Connected experiences','brands-20','https://www.mimicmobility.com/'],['Mimic Immersive','Art & spatial storytelling','brands-22','https://www.mimicimmersive.com/']];
const more=[['Mimic Gaming','https://www.mimicgaming.com/'],['Mimic Music Videos','https://www.mimicmusicvideos.com/'],['Mimic Creatures','https://www.mimiccreatures.com/'],['Mimic Cartoon','https://www.mimiccartoon.com/'],['Mimic Influencer','https://www.mimicinfluencer.com/'],['Mimic HealthXR','https://www.mimichealthxr.com/'],['Mimic Wellbeing','https://www.mimicwellbeing.com/'],['Mimic Business','https://www.mimicbusiness.com/'],['Mimic AI Labs','https://www.mimicailabs.com/'],['Mimic NFTs','https://www.mimicnfts.com/']];
const faq=[['What does David speak about?','Digital humans, conversational AI, facial animation, digital identity and the creative and ethical questions around these technologies.'],['How can I invite David to an event?','Email the event name, location, dates and the format you have in mind. Include the audience and topics you would like to explore.'],['Where can I see his film credits?','David’s IMDb profile is linked in the credits section. His career spans facial animation and performance capture across film and realtime experiences.'],['Which Mimic company should I contact?','For commissioned digital humans, character production and performance capture, start with Mimic Productions. For the AI avatar platform and its plans, explore Mimic Minds.'],['Can I try the AI avatar platform?','Yes. Visit Mimic AI Studio through Mimic Minds to explore the available tools, plans and deployment options.'],['Is David available for interviews?','For interviews, podcasts and editorial enquiries, email a short outline and your proposed timing.']];
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><meta name="description" content="David Bennett, founder of Mimic Productions and Mimic Minds. Explore digital humans, film credits, speaking and the Mimic ecosystem."/><meta http-equiv="Content-Security-Policy" content="default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self' ws://127.0.0.1:4398; frame-src 'none'; worker-src 'none'; object-src 'none'; base-uri 'self'"/><title>David Bennett | Digital humans. Human possibilities.</title><link rel="icon" href="/favicon.svg"/><link rel="preload" href="/fonts/manrope.woff2" as="font" type="font/woff2" crossorigin/><link rel="preload" href="/images/david-cutout.webp" as="image"/></head>
<body><a class="skip" href="#main">Skip to content</a><div class="site-frame">
<header class="masthead"><a class="identity" href="#home" aria-label="David Bennett home"><span class="monogram">DB<span>.</span></span><span>DAVID BENNETT<small>FOUNDER · FUTURIST · SPEAKER</small></span></a><button class="menu-toggle" aria-controls="navigation" aria-expanded="false">Menu <Icon name="plus" size={16}/></button><nav id="navigation" aria-label="Main navigation"><a href="#about">About</a><a href="#companies">Companies</a><a href="#events">Speaking</a><a href="#credits">Credits</a><a href="#mimicverse">Mimicverse</a><a href="#contact">Contact</a></nav><a class="button small header-connect" href={linkedin} target="_blank" rel="noopener noreferrer">Let’s connect <Icon name="linkedin" size={15}/></a></header>
<main id="main">
<section class="hero dark" id="home"><div class="hero-copy"><span class="pill"><span class="status-dot"></span>FOUNDER. FUTURIST. HUMAN AT HEART.</span><h1>Making technology<br/><em>more human.</em></h1><p>I’m David Bennett, founder of Mimic Productions and Mimic Minds. I bring performance, imagination and AI together to create digital humans.</p><div class="hero-facts"><div><Icon name="cube"/><strong>30+<small>Years in digital humans</small></strong></div><div><Icon name="linkedin"/><strong>20K+<small>LinkedIn followers</small></strong></div><div><Icon name="globe"/><strong>Berlin<small>Working worldwide</small></strong></div></div><div class="button-row"><a class="button" href="#companies">Explore my world <Icon/></a><a class="button outline" href="#events"><span class="play-mark"><Icon name="play" size={12}/></span>See me speak</a></div></div><div class="hero-visual"><div class="portrait-glow"></div><div class="character-mosaic"><img src="/images/brands-0.webp" alt="A selection of digital humans and character work from Mimic Productions" width="1100" height="700"/><span>DIGITAL HUMANS.<br/>REAL EXPRESSION.</span></div><div class="portrait-ring"></div><img class="hero-portrait" src="/images/david-cutout.webp" alt="David Bennett, founder of Mimic Productions and Mimic Minds" width="1100" height="1100" fetchpriority="high"/><span class="handwriting hero-sign">David Bennett</span><div class="portrait-label"><span class="status-dot"></span>THE HUMAN BEHIND MIMIC</div></div></section>
<div class="collaboration-strip"><span>CAREER COLLABORATIONS INCLUDE</span><p>Cate Blanchett <b>·</b> Keanu Reeves <b>·</b> Beyoncé <b>·</b> Lady Gaga</p><a href="#credits">Explore the work <Icon size={16}/></a></div>
<section class="about light section" id="about"><div class="about-photo"><img src="/images/events-13.webp" alt="David Bennett at the Montreal International Game Summit" width="1280" height="1600" loading="lazy"/><div class="metric-sticker"><strong>30+</strong><span>YEARS OF CURIOSITY<br/>AND CHARACTER CRAFT</span></div></div><div class="about-copy"><span class="eyebrow">HELLO, I’M DAVID</span><h2>A lifetime exploring<br/>what makes us <em>human.</em></h2><p>My work began with performance and facial animation, bringing characters to life in films including <i>Avatar</i>, <i>Tintin</i> and <i>Rise of the Planet of the Apes</i>.</p><p>Today, I’m building on that foundation through Mimic Productions and Mimic Minds, exploring how digital characters can move, speak and connect with us in real time.</p><div class="about-tags"><span><Icon name="cube"/>Digital human creator</span><span><Icon name="mic"/>International speaker</span><span><Icon name="spark"/>Founder & technologist</span></div><a class="text-button" href={imdb} target="_blank" rel="noopener noreferrer">Explore my career <Icon size={16}/></a></div><span class="handwriting about-note" aria-hidden="true">Expression.<br/>Imagination.<br/>Connection.</span></section>
<section class="perspectives light section"><div class="section-intro"><span class="eyebrow">THE QUESTIONS THAT DRIVE ME</span><h2>What happens when<br/>technology has <em>a face?</em></h2><p>From the smallest expression to a conversation that feels natural, this is the space I work in.</p><a class="button" href="#events">Explore the conversations <Icon size={17}/></a></div><div class="topic-grid">{topics.map(([icon,title,description])=><article><Icon name={icon} size={25}/><h3>{title}</h3><p>{description}</p></article>)}</div></section>
<section class="companies dark section" id="companies"><div class="section-heading"><div><span class="eyebrow">THE COMPANIES I’M BUILDING</span><h2>From performance<br/>to <em>conversation.</em></h2></div><p>A production studio and an AI platform.<br/>Two ways to bring a digital human to life.</p></div><div class="company-grid"><article class="company-card"><div class="company-picture"><img src="/images/home-20.webp" alt="Mimic Productions performance capture studio" width="1000" height="560" loading="lazy"/><span class="pill">STUDIO & SERVICES</span></div><div class="company-copy"><span class="brand-name">mimic<span>PRODUCTIONS</span></span><h3>Your imagination.<br/>Our character craft.</h3><p>Commissioned digital humans, scanning, performance capture and animation for film, games, brands and immersive experiences.</p><a class="text-button" href="https://www.mimicproductions.com/" target="_blank" rel="noopener noreferrer">Explore Mimic Productions <Icon size={17}/></a></div></article><article class="company-card"><div class="company-picture"><img src="/images/brands-4.webp" alt="A digital avatar from the Mimic Minds character platform" width="1000" height="560" loading="lazy"/><span class="pill">PRODUCT & PLATFORM</span></div><div class="company-copy"><span class="brand-name">mimic<span>MINDS</span></span><h3>Create a character.<br/>Start a conversation.</h3><p>Create and deploy conversational AI avatars through Mimic AI Studio, with self-service plans and enterprise options.</p><a class="text-button" href="https://www.mimicminds.com/mimic-ai-studio" target="_blank" rel="noopener noreferrer">Discover Mimic Minds <Icon size={17}/></a></div></article></div><span class="handwriting companies-note" aria-hidden="true">Different paths.<br/>Shared curiosity.</span></section>
<section class="events light section" id="events"><div class="section-heading"><div><span class="eyebrow">ON STAGE & IN THE ROOM</span><h2>Ideas are better<br/><em>in conversation.</em></h2></div><div class="events-actions"><p>Selected talks, panels and appearances.</p><div class="slider-controls"><button data-events-prev aria-label="Previous events" aria-controls="event-track"><Icon name="chevron"/></button><button data-events-pause aria-label="Pause automatic event slides" aria-pressed="false"><Icon name="pause" size={17}/><span>Pause</span></button><button data-events-next aria-label="Next events" aria-controls="event-track"><Icon name="chevron"/></button></div></div></div><div class="event-track" id="event-track" aria-label="David’s selected speaking appearances">{events.map(e=><article class="event-card"><a href={e.href} target="_blank" rel="noopener noreferrer"><div class="event-photo"><img src={e.image} alt={'David Bennett at '+e.title} width="900" height="560" loading="lazy"/><span>{e.role}</span></div><div class="event-copy"><span class="eyebrow">{e.place}</span><h3>{e.title}</h3><p>{e.description}</p><span class="event-link">View appearance <Icon size={16}/></span></div></a></article>)}</div><div class="event-footer"><span data-events-position>01 / 04</span><span class="slider-rule"></span><a href="https://www.davidaaronbennett.com/events" target="_blank" rel="noopener noreferrer">All appearances <Icon size={16}/></a></div></section>
<section class="credits dark section" id="credits"><div class="section-heading"><div><span class="eyebrow">SELECTED CAREER CREDITS</span><h2>A few stories<br/>you might <em>recognise.</em></h2></div><div class="imdb-intro"><span class="imdb-mark">IMDb</span><p>Facial animation. Performance capture.<br/>A career bringing characters to the screen.</p><a class="text-button" href={imdb} target="_blank" rel="noopener noreferrer">View David’s IMDb profile <Icon size={17}/></a></div></div><div class="film-grid">{films.map(([image,title,year])=><a class="film-card" href={imdb} target="_blank" rel="noopener noreferrer"><img src={'/images/'+image+'.webp'} alt={title+' film artwork'} width="400" height="580" loading="lazy"/><div><h3>{title}</h3><span>{year}</span></div></a>)}</div><p class="credit-note">Selected credits from David’s career, including work before founding Mimic Productions.</p></section>
<section class="ecosystem light section" id="mimicverse"><div class="center-heading"><span class="eyebrow">THE MIMIC ECOSYSTEM</span><h2>One curiosity.<br/><em>Many worlds.</em></h2><p>Specialist brands connected by digital humans, 3D production and AI.</p></div><div class="ecosystem-roots"><a href="https://www.mimicproductions.com/" target="_blank" rel="noopener noreferrer"><Icon name="cube"/><span><strong>Mimic Productions</strong><small>Commissioned production & industry studios</small></span><Icon size={17}/></a><a href="https://www.mimicminds.com/" target="_blank" rel="noopener noreferrer"><Icon name="spark"/><span><strong>Mimic Minds</strong><small>AI Studio · Personas · Enterprise</small></span><Icon size={17}/></a></div><div class="network-line"><span>EXPLORE THE SPECIALIST STUDIOS</span></div><div class="studio-grid">{studios.map(([title,description,image,href])=><a href={href} target="_blank" rel="noopener noreferrer"><div><img src={'/images/'+image+'.webp'} alt={title+' work'} width="700" height="500" loading="lazy"/><span class="studio-arrow"><Icon size={16}/></span></div><h3>{title}</h3><p>{description}</p></a>)}</div><button class="text-button more-studios" data-more-studios aria-expanded="false" aria-controls="more-studios">More of the Mimicverse <Icon name="plus" size={17}/></button><div class="more-studios-grid" id="more-studios" hidden>{more.map(([name,href])=><a href={href} target="_blank" rel="noopener noreferrer">{name}<Icon size={15}/></a>)}</div></section>
<section class="linkedin-section section"><div class="linkedin-photo"><img src="/images/events-0.webp" alt="David Bennett at the Euphoria screening" width="900" height="1000" loading="lazy"/><div class="linkedin-metric"><Icon name="linkedin" size={26}/><strong>20K+</strong><span>FOLLOWERS ON LINKEDIN</span></div></div><div class="linkedin-copy"><span class="eyebrow">LET’S STAY CONNECTED</span><h2>Still curious.<br/>Still building.<br/><em>Still sharing.</em></h2><p>Behind the scenes at Mimic, thoughts on digital humans and conversations from the road. Follow along on LinkedIn.</p><a class="button" href={linkedin} target="_blank" rel="noopener noreferrer">Connect with David <Icon name="linkedin" size={18}/></a><span class="handwriting linkedin-note" aria-hidden="true">Good ideas start<br/>with a conversation.</span></div></section>
<section class="speaking-banner dark section"><img src="/images/events-11.webp" alt="David Bennett presenting at an industry event" width="1000" height="650" loading="lazy"/><div><span class="eyebrow">A HUMAN VIEW OF WHAT COMES NEXT</span><h2>Let’s bring the<br/><em>conversation to you.</em></h2><p>Keynotes, panels, interviews and conversations about digital humans, AI and creative technology.</p><a class="button" href={email+'?subject=Speaking%20invitation'}>Invite David to speak <Icon name="mic" size={17}/></a></div><span class="handwriting" aria-hidden="true">See you<br/>on stage.</span></section>
<section class="faq dark section" id="questions"><div class="center-heading"><span class="pill">A FEW QUESTIONS</span><h2>Before we <em>connect.</em></h2></div><div class="faq-grid">{faq.map(([question,answer])=><details><summary>{question}<Icon name="plus" size={16}/></summary><p>{answer}</p></details>)}</div><a class="text-button" href={email}>Something else on your mind? Say hello <Icon size={16}/></a></section>
<section class="contact light section" id="contact"><div><span class="eyebrow">LET’S CONNECT</span><h2>Have something<br/>in <em>mind?</em></h2><p>A collaboration. An idea. A conversation.<br/>I’d like to hear about it.</p><div class="button-row"><a class="button" href={email}>Get in touch <Icon name="mail" size={17}/></a><a class="text-button" href={linkedin} target="_blank" rel="noopener noreferrer">Find me on LinkedIn <Icon size={16}/></a></div></div><div class="contact-image"><img src="/images/david-founder.webp" alt="David Bennett, founder of Mimic Productions" width="900" height="900" loading="lazy"/><span class="handwriting">David Bennett</span></div></section>
</main><footer class="footer dark"><div class="footer-top"><a class="identity" href="#home"><span class="monogram">DB<span>.</span></span><span>DAVID BENNETT<small>FOUNDER · FUTURIST · SPEAKER</small></span></a><nav aria-label="Social profiles"><a href={linkedin} target="_blank" rel="noopener noreferrer" aria-label="David on LinkedIn"><Icon name="linkedin" size={18}/></a><a href={imdb} target="_blank" rel="noopener noreferrer">IMDb</a><a href="https://www.instagram.com/davidaaronbennett/" target="_blank" rel="noopener noreferrer">Instagram</a><a href={email} aria-label="Email David"><Icon name="mail" size={18}/></a></nav><a href="#home" class="back-top">BACK TO TOP <Icon size={15}/></a></div><div class="footer-bottom"><span>© {new Date().getFullYear()} David Bennett</span><span>Mimic Productions <b>·</b> Mimic Minds</span><a href={email}>dbennett@mimicproductions.com</a></div></footer>
</div>
<script>
const menu=document.querySelector<HTMLButtonElement>('.menu-toggle');const nav=document.querySelector<HTMLElement>('#navigation');
menu?.addEventListener('click',()=>{const open=menu.getAttribute('aria-expanded')!=='true';menu.setAttribute('aria-expanded',String(open));nav?.classList.toggle('open',open)});
nav?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{nav.classList.remove('open');menu?.setAttribute('aria-expanded','false')}));
document.addEventListener('keydown',e=>{if(e.key==='Escape'){nav?.classList.remove('open');menu?.setAttribute('aria-expanded','false')}});
const more=document.querySelector<HTMLButtonElement>('[data-more-studios]');more?.addEventListener('click',()=>{const expanded=more.getAttribute('aria-expanded')!=='true';more.setAttribute('aria-expanded',String(expanded));document.getElementById('more-studios')!.hidden=!expanded;});
const track=document.querySelector<HTMLElement>('#event-track')!;const pause=document.querySelector<HTMLButtonElement>('[data-events-pause]')!;const reduced=matchMedia('(prefers-reduced-motion: reduce)');let paused=reduced.matches,hovered=false,focused=false,visible=false,timer:ReturnType<typeof setInterval>|undefined;
const step=()=>track.querySelector('article')!.getBoundingClientRect().width+24;
const positions=()=>Math.max(1,Math.round((track.scrollWidth-track.clientWidth)/step())+1);
const update=()=>{document.querySelector('[data-events-position]')!.textContent=String(Math.round(track.scrollLeft/step())+1).padStart(2,'0')+' / '+String(positions()).padStart(2,'0');};
const move=(direction:number)=>{const count=positions();const index=(Math.round(track.scrollLeft/step())+direction+count)%count;track.scrollTo({left:index*step(),behavior:reduced.matches?'instant':'smooth'})};
const sync=()=>{if(timer)clearInterval(timer);if(!paused&&!hovered&&!focused&&visible&&!document.hidden&&!reduced.matches)timer=setInterval(()=>move(1),5200);pause.setAttribute('aria-pressed',String(paused));pause.setAttribute('aria-label',paused?'Start automatic event slides':'Pause automatic event slides');pause.querySelector('span')!.textContent=paused?'Play':'Pause';};
pause.addEventListener('click',()=>{paused=!paused;sync()});
document.querySelector('[data-events-next]')?.addEventListener('click',()=>{paused=true;move(1);sync()});document.querySelector('[data-events-prev]')?.addEventListener('click',()=>{paused=true;move(-1);sync()});
track.addEventListener('mouseenter',()=>{hovered=true;sync()});track.addEventListener('mouseleave',()=>{hovered=false;sync()});track.addEventListener('focusin',()=>{focused=true;sync()});track.addEventListener('focusout',()=>{focused=false;sync()});track.addEventListener('pointerdown',()=>{paused=true;sync()});track.addEventListener('scroll',update,{passive:true});
new IntersectionObserver(e=>{visible=e[0].isIntersecting;sync()},{threshold:.2}).observe(track);document.addEventListener('visibilitychange',sync);reduced.addEventListener('change',()=>{if(reduced.matches)paused=true;sync()});addEventListener('resize',update);update();sync();
</script>
</body></html>
